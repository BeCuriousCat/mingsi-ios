{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mingsi:mentor-m1:turn:1.0.0",
  "title": "MingSi M1 Mentor Response",
  "description": "The client must additionally validate sources, lesson eligibility, user intent and the recall budget against the request snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "material_status", "body", "question", "question_purpose", "source_refs", "lesson_ref", "suggested_actions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "action": { "enum": ["clarify", "explain", "compare", "advise", "close"] },
    "material_status": { "enum": ["missing", "usable", "not_needed"] },
    "body": { "type": "string", "minLength": 1, "maxLength": 12000, "pattern": "\\S" },
    "question": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      ]
    },
    "question_purpose": { "enum": [null, "material", "reflection"] },
    "source_refs": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_id" }
    },
    "lesson_ref": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^L[0-9]{2}$" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$", "maxLength": 32 }
          }
        }
      ]
    },
    "suggested_actions": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["reply", "explain", "another_lesson", "draft_understanding", "finish"] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "clarify" } }, "required": ["action"] },
      "then": { "properties": { "question": { "type": "string" } } }
    },
    {
      "if": { "properties": { "question": { "type": "null" } }, "required": ["question"] },
      "then": { "properties": { "question_purpose": { "type": "null" } } },
      "else": { "properties": { "question_purpose": { "enum": ["material", "reflection"] } } }
    },
    {
      "if": {
        "properties": { "material_status": { "const": "missing" }, "question": { "type": "string" } },
        "required": ["material_status", "question"]
      },
      "then": { "properties": { "question_purpose": { "const": "material" } } }
    }
  ],
  "$defs": {
    "source_id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:(?:item|capture|legacy-nudge|understanding):[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|lesson:L[0-9]{2}@[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"
    }
  }
}
